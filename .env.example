# === OBBLIGATORIE ===
# Token del bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# === OPZIONALI ===
# Se usi il plugin PostgreSQL di Railway, questa variabile la mette Railway da solo
# (oppure scrivi: DATABASE_URL=${{Postgres.DATABASE_URL}} nelle variabili del servizio)
DATABASE_URL=

# SSL per Postgres: auto (default) | true | false
PGSSL=auto

# Se NON usi Postgres: cartella dove salvare i dati (monta qui un Volume di Railway, es. /data)
DATA_DIR=./data

# Testo dello stato del bot ("Sta guardando ...")
BOT_STATUS=🏝️ Taxe Cayo Perico
